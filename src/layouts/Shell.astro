---
import "@fontsource-variable/source-serif-4/opsz.css";
import "@fontsource-variable/source-serif-4/opsz-italic.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import Mark from "../components/Mark.astro";
import { getNotes } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  /** Section this page belongs to, for the header nav. */
  section?: "notes" | "projects";
  /** The home page renders its own large name, so it skips the small one. */
  home?: boolean;
}

const SITE_NAME = "Richard Beattie";

const {
  title,
  description = "Richard Beattie is an engineer at C5R, building the physical environments where models can conduct scientific research.",
  section,
  home = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Notes only shows up in the nav once there's something to read.
const hasNotes = (await getNotes()).length > 0;
const nav = [
  ...(hasNotes ? [{ href: "/notes", label: "Notes", key: "notes" }] : []),
  { href: "/projects", label: "Projects", key: "projects" },
];

const links = [
  { href: "https://github.com/r-bt", label: "GitHub" },
  { href: "https://www.linkedin.com/in/richard--beattie/", label: "LinkedIn" },
  { href: "/resume.pdf", label: "Résumé" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f9f5ec" />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_NAME} />
    <!-- 1213t logo on a cream tile. The SVG wins where supported; the rest are fallbacks. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <header
      class:list={[
        "frame flex items-baseline gap-6 pt-8 sm:pt-12",
        home ? "justify-end" : "justify-between pb-10",
      ]}
    >
      {
        !home && (
          <a href="/" class="text-[1.0625rem] font-semibold text-ink no-underline">
            {SITE_NAME}
          </a>
        )
      }
      <nav aria-label="Sections" class="meta flex gap-4">
        {nav.map(({ href, label, key }) => (
          <a
            href={href}
            class="quiet-link"
            aria-current={section === key ? "page" : undefined}
          >
            {label}
          </a>
        ))}
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="frame mt-24 pb-10">
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-rule pt-6">
        <a href="/" class="text-muted transition-colors hover:text-ink" aria-label="Home">
          <Mark class="h-6 w-auto" />
        </a>
        <ul class="meta flex flex-wrap gap-x-4 gap-y-1">
          {
            links.map(({ href, label }) => (
              <li>
                <a class="quiet-link" href={href}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>

    <script>
      import { inject } from "@vercel/analytics";
      inject();
    </script>
  </body>
</html>
