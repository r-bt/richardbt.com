---
// A grid of photos that open into a full-screen viewer.
//
//   <Gallery
//     dir="glass-blown-turtle/gallery"
//     items={[["rose-goblet", "A goblet with a rose on the stem"], ...]}
//   />
//
// Each item is [file name without extension, caption]. Files are looked up in
// src/content/projects/<dir>/ as .jpg, .jpeg, .png or .webp.
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  dir: string;
  items: [name: string, caption: string][];
}

const { dir, items } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/projects/**/*.{jpg,jpeg,png,webp}",
);

const photos = await Promise.all(
  items.map(async ([name, caption]) => {
    const key = Object.keys(files).find((path) =>
      new RegExp(`^/src/content/projects/${dir}/${name}\\.(jpe?g|png|webp)$`).test(path),
    );
    if (!key) throw new Error(`Gallery: no image "${name}" in src/content/projects/${dir}`);
    const src = (await files[key]()).default;
    const full = await getImage({ src, width: Math.min(src.width, 2000), format: "webp" });
    return { src, caption, full: full.src };
  }),
);
---

<div class="gallery wide" data-gallery>
  <div class="gallery-grid">
    {
      photos.map(({ src, caption }, i) => (
        <figure class="gallery-item">
          <button type="button" class="gallery-open" data-index={i} aria-label={`View larger: ${caption}`}>
            <Image
              class="gallery-thumb"
              src={src}
              alt={caption}
              widths={[320, 480, 720]}
              sizes="(min-width: 50rem) 16rem, (min-width: 640px) 31vw, 46vw"
            />
          </button>
          <figcaption>{caption}</figcaption>
        </figure>
      ))
    }
  </div>

  <dialog class="gallery-viewer" aria-label="Photo viewer">
    <figure class="gallery-stage">
      <img class="gallery-full" alt="" />
      <figcaption class="gallery-caption"></figcaption>
    </figure>
    <span class="gallery-count" aria-live="polite"></span>
    <button type="button" class="gallery-btn gallery-close" aria-label="Close">✕</button>
    <button type="button" class="gallery-btn gallery-prev" aria-label="Previous photo">←</button>
    <button type="button" class="gallery-btn gallery-next" aria-label="Next photo">→</button>
  </dialog>

  <script type="application/json" set:html={JSON.stringify(photos.map(({ full, caption }) => ({ full, caption })))} />
</div>

<script>
  type Photo = { full: string; caption: string };

  for (const root of document.querySelectorAll<HTMLElement>("[data-gallery]")) {
    const photos: Photo[] = JSON.parse(root.querySelector("script[type='application/json']")!.textContent!);
    const dialog = root.querySelector<HTMLDialogElement>(".gallery-viewer")!;
    const img = dialog.querySelector<HTMLImageElement>(".gallery-full")!;
    const caption = dialog.querySelector<HTMLElement>(".gallery-caption")!;
    const count = dialog.querySelector<HTMLElement>(".gallery-count")!;
    let index = 0;

    const show = (i: number) => {
      index = (i + photos.length) % photos.length;
      img.src = photos[index].full;
      img.alt = photos[index].caption;
      caption.textContent = photos[index].caption;
      count.textContent = `${index + 1} / ${photos.length}`;
      // Warm the next photo so arrowing through feels instant.
      new Image().src = photos[(index + 1) % photos.length].full;
    };

    root.querySelectorAll<HTMLButtonElement>(".gallery-open").forEach((button) =>
      button.addEventListener("click", () => {
        show(Number(button.dataset.index));
        dialog.showModal();
      }),
    );

    dialog.querySelector(".gallery-prev")!.addEventListener("click", () => show(index - 1));
    dialog.querySelector(".gallery-next")!.addEventListener("click", () => show(index + 1));
    dialog.querySelector(".gallery-close")!.addEventListener("click", () => dialog.close());

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(index - 1);
      if (event.key === "ArrowRight") show(index + 1);
    });

    // Clicking the dark backdrop (not the photo or a button) closes the viewer.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog || event.target === dialog.querySelector(".gallery-stage")) dialog.close();
    });

    // Swipe left and right on touch screens.
    let startX: number | null = null;
    dialog.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "touch") startX = event.clientX;
    });
    dialog.addEventListener("pointerup", (event) => {
      if (startX === null) return;
      const dx = event.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .gallery {
    margin-top: 1.5rem;
    margin-bottom: 1rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 0.875rem;
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.75rem 1.25rem;
    }
  }

  .gallery-item {
    margin: 0;
  }

  .gallery-open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 3px;
    overflow: hidden;
    background: var(--tint);
    cursor: zoom-in;
  }

  /* Beats the article's own image rules, which size images for running text. */
  .gallery .gallery-thumb {
    display: block;
    width: 100%;
    height: auto;
    max-height: none;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 0;
    transition: transform 300ms ease;
  }

  .gallery-open:hover .gallery-thumb {
    transform: scale(1.03);
  }

  .gallery-item figcaption {
    margin-top: 0.5rem;
    text-align: left;
  }

  /* Viewer */
  .gallery-viewer {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--paper);
  }

  .gallery-viewer::backdrop {
    background: rgba(30, 27, 22, 0.94);
  }

  .gallery-stage {
    height: 100%;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    padding: 3.5rem var(--gutter) 2rem;
  }

  .gallery .gallery-full {
    display: block;
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 3px;
    touch-action: pan-y;
  }

  .gallery .gallery-caption {
    margin: 0;
    color: var(--faint);
    text-align: center;
  }

  .gallery-count {
    position: absolute;
    top: 1.25rem;
    left: var(--gutter);
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--faint);
  }

  .gallery-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(249, 245, 236, 0.1);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 1rem;
    cursor: pointer;
    transition: background 120ms ease;
  }

  .gallery-btn:hover {
    background: rgba(249, 245, 236, 0.22);
  }

  .gallery-close {
    top: 0.625rem;
    right: var(--gutter);
  }

  .gallery-prev,
  .gallery-next {
    top: 50%;
    transform: translateY(-50%);
  }

  .gallery-prev {
    left: var(--gutter);
  }

  .gallery-next {
    right: var(--gutter);
  }

  /* On phones the arrows would cover the photo; swipe instead and keep them low. */
  @media (max-width: 639px) {
    .gallery-stage {
      padding-bottom: 4.5rem;
    }

    .gallery-prev,
    .gallery-next {
      top: auto;
      bottom: 1rem;
      transform: none;
    }
  }
</style>
