---
import { render } from "astro:content";
import Article from "../../layouts/Article.astro";
import { getProjects, slugOf, topicsOf, type Project } from "../../lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: slugOf(project.id) },
    props: { project },
  }));
}

const { project } = Astro.props as { project: Project };
const { Content } = await render(project);
const { title, description, publishDate, thumbnail } = project.data;
---

<Article
  section="projects"
  title={title}
  description={description}
  meta={[String(publishDate.getUTCFullYear()), ...topicsOf(project)]}
  hero={thumbnail}
>
  <Content />
</Article>
