---
import { render } from "astro:content";
import Article from "../../layouts/Article.astro";
import { getBuild, getProjects, slugOf, topicsOf, type Project } from "../../lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: slugOf(project.id) },
    props: { project },
  }));
}

const { project } = Astro.props as { project: Project };
const { Content } = await render(project);
const { title, description, publishDate, thumbnail } = project.data;
const slug = slugOf(project.id);
const build = await getBuild(slug);
---

<Article
  section="projects"
  title={title}
  description={description}
  meta={[String(publishDate.getUTCFullYear()), ...topicsOf(project)]}
  hero={thumbnail}
>
  <Content />
  {
    build && (
      <a class="build-link bare" href={`/projects/${slug}/build`}>
        <span class="build-link-title">{build.data.title ?? "How it was made"}</span>
        <span aria-hidden="true" class="build-link-arrow">→</span>
      </a>
    )
  }
</Article>
