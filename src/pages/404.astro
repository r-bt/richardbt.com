---
import Shell from "../layouts/Shell.astro";
---

<Shell title="Not found">
  <div class="frame">
    <p class="label">404</p>
    <h1 class="mt-3 text-[2.125rem] font-semibold leading-tight text-ink">Nothing here.</h1>
    <p class="mt-4 text-muted">
